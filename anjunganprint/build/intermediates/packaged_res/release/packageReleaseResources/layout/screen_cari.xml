<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_horizontal"
        android:maxWidth="600dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnPengaturan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackground"
            android:padding="10dp"
            android:text="Pengaturan"
            android:textColor="#9FB6E8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_logo_box"
                android:contentDescription="@string/title_cari"
                android:padding="20dp"
                android:src="@drawable/ic_person_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/title_cari"
                android:textColor="@color/ink"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/subtitle_cari"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/ChipStyle"
                    android:text="No. RM" />

                <TextView
                    style="@style/ChipStyle"
                    android:text="NIK KTP" />

                <TextView
                    style="@style/ChipStyle"
                    android:text="Nama" />

                <TextView
                    style="@style/ChipStyle"
                    android:text="Alamat" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/ChipStyle"
                    android:text="No. HP" />

                <TextView
                    style="@style/ChipStyle"
                    android:text="Nama Ibu" />

                <TextView
                    style="@style/ChipStyle"
                    android:text="No. Peserta" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCari"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_field"
                    android:gravity="center"
                    android:hint="@string/hint_cari"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="14dp"
                    android:textColor="@color/ink"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCari"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="@string/btn_cari"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFotoKtp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/btn_foto_ktp"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnKamera"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_outline"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/btn_kamera"
                    android:textColor="#0A5CFF" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbCari"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
